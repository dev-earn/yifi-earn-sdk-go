# Copy to .env and fill in real values. Never commit .env.

YIFI_PARTNER_ID=your_partner_id
YIFI_API_KEY=yifi_pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
YIFI_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

PRIVATE_KEY=your_wallet_private_key_hex_no_0x_prefix
WALLET_ADDRESS=0xYourWalletAddress

# Optional lifecycle overrides.
YIFI_CYCLE_INPUT_AMOUNT=100000000000000000
YIFI_CLAIM_MODE=single
YIFI_UPDATE_CLAIM_ADDRESS=0
YIFI_TOTP_CODE=your_current_totp_code_if_required

RPC_URL=https://your-rpc-provider/v2/your-rpc-key
RPC_URL_ETHEREUM=https://eth-mainnet.your-rpc-provider/v2/your-rpc-key
RPC_URL_ARBITRUM=https://arb-mainnet.your-rpc-provider/v2/your-rpc-key
RPC_URL_BSC=https://bnb-mainnet.your-rpc-provider/v2/your-rpc-key
RPC_URL_OPTIMISM=https://opt-mainnet.your-rpc-provider/v2/your-rpc-key
RPC_URL_BASE=https://base-mainnet.your-rpc-provider/v2/your-rpc-key
RPC_URL_POLYGON=https://polygon-mainnet.your-rpc-provider/v2/your-rpc-key
